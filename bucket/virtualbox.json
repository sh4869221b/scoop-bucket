{
    "version": "7.2.22",
    "description": "Powerful x86 and AMD64/Intel64 virtualization product for enterprise as well as home use.",
    "homepage": "https://www.virtualbox.org/",
    "license": "GPL-2.0-only",
    "installer": {
        "script": [
            "$setup = Join-Path $dir \"VBoxSetup.exe\"",
            "$arguments = '--msiparams \"INSTALLDIR=\"\"{0}\"\" VBOX_START=0 REBOOT=ReallySuppress\" --silent' -f $dir",
            "$process = Start-Process -FilePath $setup -ArgumentList $arguments -Verb RunAs -Wait -PassThru -ErrorAction Stop",
            "if ($process.ExitCode -notin 0, 3010) { throw \"VirtualBox installer failed with exit code $($process.ExitCode).\" }",
            "if (-not (Test-Path -LiteralPath (Join-Path $dir \"VirtualBox.exe\") -PathType Leaf)) { throw \"VirtualBox was not installed into the Scoop directory.\" }"
        ]
    },
    "post_install": "Remove-Item -LiteralPath (Join-Path $dir \"VBoxSetup.exe\")",
    "uninstaller": {
        "script": [
            "if (Test-Path -LiteralPath (Join-Path $dir \"VirtualBox.exe\") -PathType Leaf -ErrorAction Stop) {",
            "    abort \"Remove Oracle VirtualBox through Windows Installed apps, then rerun the Scoop command.\"",
            "}"
        ]
    },
    "bin": "VBoxManage.exe",
    "shortcuts": [
        [
            "VirtualBox.exe",
            "Oracle VM VirtualBox"
        ]
    ],
    "checkver": {
        "url": "https://update.virtualbox.org/query.php?platform=WINDOWS_64BITS_GENERIC&version=0.0.0",
        "regex": "VirtualBox-(?<version>[\\d.]+)-(?<revision>[\\d]+)-Win.exe"
    },
    "autoupdate": {
        "hash": {
            "url": "https://download.virtualbox.org/virtualbox/$version/SHA256SUMS"
        },
        "architecture": {
            "64bit": {
                "url": "https://download.virtualbox.org/virtualbox/$version/VirtualBox-$version-$matchRevision-Win.exe#/VBoxSetup.exe"
            }
        }
    },
    "notes": [
        "The Oracle installer requires a custom location with restricted parent directory permissions.",
        "Before updating or uninstalling in Scoop, remove Oracle VirtualBox through Windows Installed apps."
    ],
    "architecture": {
        "64bit": {
            "url": "https://download.virtualbox.org/virtualbox/7.2.22/VirtualBox-7.2.22-175245-Win.exe#/VBoxSetup.exe",
            "hash": "afd0ff1656cbe04ed88ce619594ae021419d97cce89fa9bdc443e9a963f1713f"
        }
    }
}
