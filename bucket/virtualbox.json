{
    "version": "7.2.22",
    "description": "Oracle VirtualBox for Windows on x64 or Windows 11 on ARM64 (experimental).",
    "homepage": "https://www.virtualbox.org/",
    "license": "GPL-2.0-only",
    "installer": {
        "script": [
            "$inventory = Join-Path $dir \"vbox-msi-inventory.ps1\"",
            "if (@(& $inventory).Count -ne 0) { throw \"Remove the existing Oracle VirtualBox installation through Windows Installed apps before installing through Scoop.\" }",
            "$machine = [Microsoft.Win32.RegistryKey]::OpenBaseKey([Microsoft.Win32.RegistryHive]::LocalMachine, [Microsoft.Win32.RegistryView]::Registry64)",
            "try {",
            "    $windows = $machine.OpenSubKey(\"SOFTWARE\\Microsoft\\Windows\\CurrentVersion\")",
            "    if (-not $windows) { throw \"Cannot open the native Windows registry view.\" }",
            "    try { $programFiles = $windows.GetValue(\"ProgramFilesDir\") } finally { $windows.Dispose() }",
            "} finally { $machine.Dispose() }",
            "if (-not $programFiles) { throw \"Cannot resolve the native Program Files directory.\" }",
            "$oracleDir = Join-Path $programFiles \"Oracle\\VirtualBox\"",
            "$cli = Join-Path $oracleDir \"VBoxManage.exe\"",
            "$setup = Join-Path $dir \"VBoxSetup.exe\"",
            "$arguments = '--msiparams \"VBOX_START=0 VBOX_INSTALLSTARTMENUENTRIES=1 REBOOT=ReallySuppress\" --silent'",
            "$process = Start-Process -FilePath $setup -ArgumentList $arguments -Verb RunAs -Wait -PassThru -ErrorAction Stop",
            "if ($process.ExitCode -notin 0, 3010) { throw \"VirtualBox installer failed with exit code $($process.ExitCode).\" }",
            "$registeredVersions = @(& $inventory -IncludeVersion)",
            "if ($registeredVersions.Count -ne 1 -or $registeredVersions[0] -ne $version -or",
            "    (Get-Item -LiteralPath $cli -ErrorAction Stop) -isnot [IO.FileInfo]) {",
            "    throw \"Expected Oracle VirtualBox MSI registration and binaries in Program Files. Inspect Windows Installed apps before retrying.\"",
            "}",
            "Set-Content -LiteralPath (Join-Path $dir \"vbox-manage-path.txt\") -Value $cli -Encoding UTF8 -ErrorAction Stop",
            "@(",
            "    '$exe = Get-Content -LiteralPath (Join-Path $PSScriptRoot \"vbox-manage-path.txt\") -ErrorAction Stop'",
            "    '& $exe @args'",
            "    'exit $LASTEXITCODE'",
            ") | Set-Content -LiteralPath (Join-Path $dir \"VBoxManage.ps1\") -Encoding UTF8 -ErrorAction Stop"
        ]
    },
    "post_install": "Remove-Item -LiteralPath (Join-Path $dir \"VBoxSetup.exe\")",
    "uninstaller": {
        "script": [
            "$inventory = Join-Path $dir \"vbox-msi-inventory.ps1\"",
            "if (-not (Test-Path -LiteralPath $inventory -PathType Leaf -ErrorAction Stop)) {",
            "    throw \"VirtualBox MSI inventory helper is missing. Check Windows Installed apps before repairing the Scoop entry.\"",
            "}",
            "if (@(& $inventory).Count -ne 0) {",
            "    abort \"Remove Oracle VirtualBox through Windows Installed apps, then rerun the Scoop command.\"",
            "}"
        ]
    },
    "bin": "VBoxManage.ps1",
    "checkver": {
        "url": "https://update.virtualbox.org/query.php?platform=WINDOWS_64BITS_GENERIC&version=0.0.0",
        "regex": "VirtualBox-(?<version>[\\d.]+)-(?<revision>[\\d]+)-Win.exe"
    },
    "autoupdate": {
        "hash": {
            "url": "https://download.virtualbox.org/virtualbox/$version/SHA256SUMS"
        },
        "architecture": {
            "64bit": {
                "url": "https://download.virtualbox.org/virtualbox/$version/VirtualBox-$version-$matchRevision-Win.exe#/VBoxSetup.exe"
            },
            "arm64": {
                "url": "https://download.virtualbox.org/virtualbox/$version/VirtualBox-$version-$matchRevision-Win.exe#/VBoxSetup.exe"
            }
        }
    },
    "notes": [
        "Oracle installs the application and its Start menu entry in the system locations. Scoop provides the VBoxManage shim.",
        "Remove Oracle VirtualBox through Windows Installed apps before updating or uninstalling in Scoop.",
        "Oracle describes support for Windows 11 ARM64 hosts as experimental."
    ],
    "architecture": {
        "64bit": {
            "url": "https://download.virtualbox.org/virtualbox/7.2.22/VirtualBox-7.2.22-175245-Win.exe#/VBoxSetup.exe",
            "hash": "afd0ff1656cbe04ed88ce619594ae021419d97cce89fa9bdc443e9a963f1713f"
        },
        "arm64": {
            "url": "https://download.virtualbox.org/virtualbox/7.2.22/VirtualBox-7.2.22-175245-Win.exe#/VBoxSetup.exe",
            "hash": "afd0ff1656cbe04ed88ce619594ae021419d97cce89fa9bdc443e9a963f1713f"
        }
    },
    "pre_install": [
        "$inventory = Join-Path $dir \"vbox-msi-inventory.ps1\"",
        "# Both native MSI payloads use the same Oracle VirtualBox UpgradeCode.",
        "$source = @\"",
        "[CmdletBinding()]",
        "param(",
        "    [switch]`$IncludeVersion,",
        "    [string]`$UpgradeCode = '{C4BAD770-BFE8-4D2C-A592-693028A7215B}'",
        ")",
        "`$ErrorActionPreference = 'Stop'",
        "if (-not ('ScoopBucket.VirtualBoxMsi' -as [type])) {",
        "    Add-Type -Namespace ScoopBucket -Name VirtualBoxMsi -MemberDefinition @'",
        "    [System.Runtime.InteropServices.DefaultDllImportSearchPaths(System.Runtime.InteropServices.DllImportSearchPath.System32)]",
        "    [System.Runtime.InteropServices.DllImport(\"msi.dll\", CharSet = System.Runtime.InteropServices.CharSet.Unicode, ExactSpelling = true)]",
        "    public static extern uint MsiEnumRelatedProductsW(string upgradeCode, uint reserved, uint index, System.Text.StringBuilder productCode);",
        "",
        "    [System.Runtime.InteropServices.DefaultDllImportSearchPaths(System.Runtime.InteropServices.DllImportSearchPath.System32)]",
        "    [System.Runtime.InteropServices.DllImport(\"msi.dll\", CharSet = System.Runtime.InteropServices.CharSet.Unicode, ExactSpelling = true)]",
        "    public static extern uint MsiGetProductInfoW(string productCode, string property, System.Text.StringBuilder value, ref uint size);",
        "'@",
        "}",
        "`$productCode = [Text.StringBuilder]::new(39)",
        "for ([uint32]`$index = 0; ; `$index++) {",
        "    `$result = [ScoopBucket.VirtualBoxMsi]::MsiEnumRelatedProductsW(`$UpgradeCode, 0, `$index, `$productCode)",
        "    if (`$result -eq 259) { break } # ERROR_NO_MORE_ITEMS",
        "    if (`$result -ne 0) { throw \"Cannot enumerate Oracle VirtualBox MSI registrations (error `$result).\" }",
        "    if (`$IncludeVersion) {",
        "        `$value = [Text.StringBuilder]::new(256)",
        "        [uint32]`$size = `$value.Capacity",
        "        `$result = [ScoopBucket.VirtualBoxMsi]::MsiGetProductInfoW(`$productCode.ToString(), 'VersionString', `$value, [ref]`$size)",
        "        if (`$result -ne 0) { throw \"Cannot read the installed Oracle VirtualBox MSI version (error `$result).\" }",
        "        `$value.ToString()",
        "    } else {",
        "        `$productCode.ToString()",
        "    }",
        "}",
        "\"@",
        "Set-Content -LiteralPath $inventory -Value $source -Encoding UTF8 -ErrorAction Stop"
    ]
}
